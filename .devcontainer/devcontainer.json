{
    "name": "node-pnpm",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "forwardPorts": [
    ],
    "remoteEnv": {
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
        "CLAUDE_SECRET_KEY": "${localEnv:CLAUDE_SECRET_KEY}"
    },
    "remoteUser": "node",
    "mounts": [
        "source=${localEnv:HOME}/.aws/config,target=/home/node/.aws/config,type=bind,ro=true"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "vue.volar"
            ],
            "settings": {
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash"
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}